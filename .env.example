# Copy to .env.local for local work. On Vercel set these under Project > Settings > Environment Variables.

# The website's own public address, no trailing slash (used for SEO links, sitemap and sharing previews).
# Production: https://yourdomain.com  (or https://your-site.vercel.app until the domain is connected)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The API's public address, no trailing slash. Production: https://kripty-studio-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Shared secret that lets the API refresh the website's content after an admin edit.
# Must be identical to REVALIDATE_SECRET in the backend. Generate with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
REVALIDATE_SECRET=
